def get_valid_input(min_val, max_val, prompt="Ваш выбор"):
    while True:
        choice = input(f"{prompt} ({min_val}-{max_val}): ")
        if choice.isdigit():
            num = int(choice)
            if min_val <= num <= max_val:
                return num
        
        print(f"Введите число от {min_val} до {max_val}")

def get_text_input(prompt="Ваш ответ"):
    while True:
        text = input(f"{prompt} ")
        if len(text.strip()) > 0:
            return text.strip().lower()
        print("Введите слово")

def buy_hint(q_data):
    hint_cost = q_data["hint_cost"] if "hint_cost" in q_data else {}
    cost_coins = hint_cost["монеты"] if "монеты" in hint_cost else 0
    cost_cards = hint_cost["карты"] if "карты" in hint_cost else 0
    print(f"Подсказка доступна! Стоимость: {cost_coins} монет или {cost_cards} карты")
    print("1. Купить подсказку")
    print("2. Пропустить")
    if get_valid_input(1, 2, "Ваш выбор") == 2:
        return False
    # Проверяем ресурсы и списываем
    if alisa["монеты"] >= cost_coins:
        alisa["монеты"] -= cost_coins
        print(f"Оплачено монетами. Осталось: {alisa['монеты']}")
    elif alisa["карты"] >= cost_cards:
        alisa["карты"] -= cost_cards
        print(f"Оплачено картами. Осталось: {alisa['карты']}")
    else:
        print("Недостаточно ресурсов")
        return False

    print("Подсказка: " + q_data["hint"])
    alisa["история"].append("Куплена подсказка")
    return True


def choose_suit():
    print("Выберите свою боевую масть:")
    suits_list = ["Черви", "Трефы", "Бубны", "Пики"]
    index = 1
    for suit in suits_list:
        print(f"{index}. {suit} сильна против: {suits[suit]['strength']}, слаба против: {suits[suit]['weakness']}")
        index += 1

    choice = get_valid_input(1, 4, "Ваш выбор")
    game_state["suit"] = suits_list[choice - 1]

    print(f"Вы выбрали масть: {game_state['suit']}")
    alisa["история"].append(f"Выбрана масть: {game_state['suit']}")


def check_suit_advantage(player_suit, enemy_suit):
    player_data = suits[player_suit]  # напрямую берём данные
    if player_data["strength"] == enemy_suit:
        return "strong"
    elif player_data["weakness"] == enemy_suit:
        return "weak"
    return "neutral"


def battle_scene(enemy_name, has_ally_help=False):
    # Проверка сразу, чтобы словари не ломались
    if enemy_name not in npcs or enemy_name not in events["battles"]:
        print("Противник не сопротивляется.")
        return True

    npc_info = npcs[enemy_name]
    battle_info = events["battles"][enemy_name]

    enemy_suit = npc_info["suit"]
    player_suit = game_state["suit"]
    advantage = check_suit_advantage(player_suit, enemy_suit)

    print(f"Битва: {enemy_name}")
    print(f"Масть врага: {enemy_suit}, Ваша масть: {player_suit}")
    if has_ally_help:
        print("Союзник помогает! Можно переответить при ошибке.")
    if advantage == "strong":
        print(f"Преимущество! Бонус: {suits[player_suit]['bonus']}")
    elif advantage == "weak":
        print("Осторожно! Масть врага сильна против вашей.")

    print(battle_info["question"])

    # Выводим варианты с обычным счётчиком
    i = 1
    for option in battle_info["options"]:
        print(f"{i}. {option}")
        i += 1

    # Первый выбор игрока
    choice = get_valid_input(1, len(battle_info["options"]), "Ваш ответ")
    is_correct = (choice - 1 == battle_info["correct"])

    # Второй шанс с союзником
    if not is_correct and has_ally_help:
        print("Союзник подсказывает: попробуй ещё раз!")
        choice = get_valid_input(1, len(battle_info["options"]), "Второй ответ")
        is_correct = (choice - 1 == battle_info["correct"])

    # Вычисляем шансы на победу компактно
    win_chance = int(is_correct) + (advantage == "strong") + has_ally_help - (advantage == "weak")

    if win_chance >= 1:
        alisa["монеты"] += npc_info["reward_coins"]
        alisa["карты"] += npc_info["reward_cards"]
        game_state["battle_wins"] += 1

        if enemy_name in alisa["враги"]:
            letter = npc_info["battle_letter"]
            alisa["буквы"].append(letter)
            alisa["враги"].remove(enemy_name)
            alisa["нейтралы"].append(enemy_name)
            print(f"Победа! Вы получили букву: {letter}")
            alisa["история"].append(f"Победа над {enemy_name} — буква {letter}")
        else:
            print(f"Победа! +{npc_info['reward_coins']} монет, +{npc_info['reward_cards']} карт")
            alisa["история"].append(f"Битва с {enemy_name}: победа")
        return True
    else:
        alisa["жизни"] -= 1
        alisa["поражения_в_боях"] += 1
        print(f"Поражение! -1 жизнь. Жизней осталось: {alisa['жизни']}")
        alisa["история"].append(f"Битва с {enemy_name}: поражение")
        return False


def final_battles():
    enemies_count = len(alisa["враги"])
    if enemies_count == 0:
        print("У вас нет врагов. Мирный финал!")
        return False

    print("Финальные битвы")

    if enemies_count == 1:
        enemy_name = alisa["враги"][0]
        has_help = len(alisa["союзники"]) >= 1
        if has_help:
            print("Союзник поможет вам в бою!")
        battle_scene(enemy_name, has_ally_help=has_help)
        game_state["battle_scenario"] = 1

    elif enemies_count == 2:
        print("Два врага! Союзник поможет только в первой битве.")
        ally_name = alisa["союзники"][0] if len(alisa["союзники"]) > 0 else None
        enemies_to_fight = alisa["враги"][:]
        i = 0
        while i < len(enemies_to_fight):
            enemy_name = enemies_to_fight[i]
            if alisa["жизни"] <= 0:
                break
            has_help = (i == 0 and ally_name is not None)
            battle_scene(enemy_name, has_ally_help=has_help)
            i += 1
        game_state["battle_scenario"] = 2

    elif enemies_count >= 3:
        print("Три врага! Вы сражаетесь в одиночку.")
        enemies_to_fight = alisa["враги"][:]
        for enemy_name in enemies_to_fight:
            if alisa["жизни"] <= 0:
                break
            battle_scene(enemy_name, has_ally_help=False)
        game_state["battle_scenario"] = 3

    return True


