def final_word_puzzle():
    letters_count = len(alisa["буквы"])
    print(f"Финальная головоломка. Собранные буквы: {', '.join(alisa['буквы'])} (всего {letters_count})")

    if letters_count < 4:
        print("Слишком мало букв. Слово угадать невозможно.")
        alisa["история"].append("Финальное слово: недостаточно букв")
        return False

    print(f"Подсказка: слово из {len(target_word)} букв - это место, куда попала Алиса")
    attempts = 0
    max_attempts = 3

    while attempts < max_attempts:
        word_input = input("Введите слово: ").lower()
        if word_input == target_word.lower():
          print(f"Верно! Слово: {target_word}")  
          alisa["история"].append(f"Финальное слово угадано: {target_word}")
          return True
        attempts += 1
        if attempts < max_attempts:
            print(f"Неверно. Осталось попыток: {max_attempts - attempts}")
        else:
            print("Попытки закончились")
            alisa["история"].append("Финальное слово не угадано")

    return False


