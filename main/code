def enemy_trap():
    if len(alisa["враги"]) == 0:
        return False

    enemy_name = alisa["враги"][0]
    if enemy_name not in npcs:
        return False

    npc_info = npcs[enemy_name]
    trap_index = len(alisa["история"]) % len(npc_info["trap_options"])
    trap_text = npc_info["trap_options"][trap_index]
    trap_effect = npc_info["trap_effects"][trap_index]

    print(f"{enemy_name} шепчет из тени: «{trap_text}». Варианты: 1. Принять  2. Отказаться")
    choice = get_valid_input(1, 2, "Ваш выбор")

    if choice == 1:
        messages = []
        if "жизни" in trap_effect:
            alisa["жизни"] += trap_effect["жизни"]
            messages.append(f"Жизней осталось: {alisa['жизни']}")
        if "монеты" in trap_effect:
            alisa["монеты"] = max(0, alisa["монеты"] + trap_effect["монеты"])
            messages.append(f"Монет осталось: {alisa['монеты']}")
        if "статы" in trap_effect:
            for stat, value in trap_effect["статы"].items():
                if stat in alisa["статы"]:
                    alisa["статы"][stat] += value
        alisa["история"].append(f"Ловушка от {enemy_name}: принята")
        messages.append("Ловушка сработала!")
        print(". ".join(messages))
    else:
        alisa["история"].append(f"Ловушка от {enemy_name}: отклонена")
        print("Вы отказались от предложения")

    return True


def memory_check(scene_index):
    if game_state["memory_check_done"]:
        return False
    if scene_index == 3:
        game_state["memory_check_done"] = True
        memory_data = events["memory"][0]
        print("Проверка памяти!")
        print(memory_data["question"])
        for i, option in enumerate(memory_data["options"]):
            print(str(i + 1) + ". " + option)
        choice = get_valid_input(1, 3, "Ваш ответ")
        if choice == memory_data["correct"] + 1:
            alisa["монеты"] = alisa["монеты"] + 10
            alisa["статы"]["любопытство"] = alisa["статы"]["любопытство"] + 5
            print("Верно! +10 монет, +5 любопытства.")
            alisa["история"].append("Проверка памяти: верно")
        else:
            alisa["монеты"] = max(0, alisa["монеты"] - 5)
            print("Неверно. -5 монет.")
            alisa["история"].append("Проверка памяти: неверно")
        return True
    return False


def meet_npc(npc_name, scene_id):
    if not npc_name or npc_name not in npcs:
        return None
    data = npcs[npc_name]
    print(f"Встреча: {npc_name}")
    correct_count = 0

    for q_data in data["questions"]:
        print(f"Вопрос: {q_data['q']}")
        if q_data.get("type") == "text":
            answer = get_text_input("Ваш ответ")
            if answer in q_data.get("correct_answers", []):
                correct_count += 1
                print("Верно!")
            elif buy_hint(q_data):
                answer2 = get_text_input("Попробуйте ещё раз")
                if answer2 in q_data.get("correct_answers", []):
                    correct_count += 1
                    print("Верно!")
        else:
            idx = 1
            for option in q_data["options"]:
                print(f"{idx}. {option}")
                idx += 1
            choice = get_valid_input(1, len(q_data["options"]), "Ваш ответ")
            if choice - 1 == q_data["correct"]:
                correct_count += 1
                print("Верно!")
            elif buy_hint(q_data):
                choice2 = get_valid_input(1, len(q_data["options"]), "Второй ответ")
                if choice2 - 1 == q_data["correct"]:
                    correct_count += 1
                    print("Верно!")

    if correct_count == 2:
        alisa["союзники"].append(npc_name)
        alisa["npc_status"][npc_name] = "ally"
        alisa["монеты"] += data["reward_coins"]
        alisa["карты"] += data["reward_cards"]
        game_state["scene_letter_earned"][scene_id] = True
        print(f"{npc_name} стал союзником! +{data['reward_coins']} монет, +{data['reward_cards']} карт")
        alisa["история"].append(f"{npc_name}: союзник")
        return "ally"
    elif correct_count == 1:
        alisa["нейтралы"].append(npc_name)
        alisa["npc_status"][npc_name] = "neutral"
        game_state["scene_letter_earned"][scene_id] = True
        print(f"{npc_name} остался нейтральным. Буква получена, но в бою он не поможет")
        alisa["история"].append(f"{npc_name}: нейтрал")
        return "neutral"
    else:
        alisa["враги"].append(npc_name)
        alisa["npc_status"][npc_name] = "enemy"
        alisa["жизни"] -= 1
        game_state["scene_letter_earned"][scene_id] = False
        print(f"{npc_name} стал врагом! -1 жизнь. Буква не получена")
        alisa["история"].append(f"{npc_name}: враг")
        return "enemy"


def check_letter_collection(scene):
    letter, req_ally, scene_id, npc_name = scene["letter"], scene["req_ally"], scene["id"], scene["npc"]
    alisa["рюкзак"].append(scene["name"])
    if not letter:
        return False

    if req_ally:
        if req_ally in alisa["союзники"]:
            alisa["буквы"].append(letter)
            alisa["история"].append(f"Буква {letter} получена при поддержке {req_ally}")
            print(f"Союзник {req_ally} помог получить букву: {letter}")
            return True
        print(f"Нет союзника ({req_ally}). Буква не получена.")
        alisa["история"].append(f"Буква не получена — нет союзника")
        return False

    if npc_name in npcs and game_state["scene_letter_earned"].get(scene_id, False):
        alisa["буквы"].append(letter)
        alisa["история"].append(f"Буква {letter} получена в сцене {scene['name']}")
        print(f"Вы получили букву: {letter}")
        return True

    if npc_name:
        print(f"Буква не получена (персонаж стал врагом).")
    return False

def get_ending(word_guessed):
    allies_count = len(alisa["союзники"])
    enemies_count = len(alisa["враги"])
    battle_wins = game_state["battle_wins"]

    if alisa["жизни"] <= 0:
        return "Потеряшка (смерть)"
    if not word_guessed:
        return "Заблудившийся (слово не угадано)"
    if allies_count == 4 and enemies_count == 0 and alisa["поражения_в_боях"] == 0:
        return "Королева чудес (идеальная победа)"
    if allies_count >= 3 and (battle_wins >= 1 or enemies_count == 0):
        return "Королева чудес"
    if allies_count == 2 and battle_wins >= 1:
        return "Дипломат"
    if allies_count == 1 and battle_wins >= 1:
        return "Искатель"
    if battle_wins >= 2 and allies_count == 0:
        return "Одинокий воин"
    if alisa["монеты"] >= 60 and allies_count <= 1:
        return "Торговец"
    if enemies_count >= 2:
        return "Потеряшка (враги)"
    return "Пробуждение"


def main_game():
    print("Игра Страна чудес")
    print(f"Соберите буквы и угадайте финальное слово. Ваши выборы влияют на концовку!")
    print(f"Слово: {'_ ' * len(target_word)}")

    choose_suit()
    scene_index = 0

    while alisa["жизни"] > 0 and scene_index < len(scenes):
        scene = scenes[scene_index]
        print(f"Сцена {scene['id']}: {scene['name']}")

        stype = scene["type"]
        if stype == "final":
            scene_index += 1
            continue
        elif stype == "npc_meet":
            meet_npc(scene["npc"], scene["id"])
        elif stype == "event_fairy":
            fairy_scene()
        elif stype == "check":
            print("Проверка союзников")

        memory_check(scene_index)
        if len(alisa["враги"]) > 0 and scene_index % 2 == 1:
            enemy_trap()

        check_letter_collection(scene)

        if len(alisa["враги"]) == 3:
            print("Все три персонажа стали врагами! Ситуация критическая.")
        if alisa["жизни"] <= 0:
            print("Жизни закончились.")
            break

        scene_index += 1

    if len(alisa["враги"]) > 0 and alisa["жизни"] > 0:
        final_battles()

    # союзники дарят буквы, которые нельзя было получить в боях
    battle_letters = [("Л", "Шляпник"), ("Е", "Кот"), ("Е", "Шляпник"), ("Ь", "Королева"), ("А", "Кот"), ("А", "Королева")]
    if len(alisa["враги"]) == 0 and alisa["жизни"] > 0:
        given = []
        for letter, npc_name in battle_letters:
            if npc_name in alisa["союзники"]:
                needed_count = sum(1 for l, n in battle_letters if l == letter)
                if alisa["буквы"].count(letter) < needed_count:
                    alisa["буквы"].append(letter)
                    given.append(letter + " от " + npc_name)
        if given:
            print("Союзники делятся своими секретами и дарят буквы: " + ", ".join(given))
    if alisa["жизни"] <= 0:
        print("Вы погибли.")
        word_guessed = False
        final_ending = "Потеряшка (смерть в бою)"
    else:
        word_guessed = final_word_puzzle()
        final_ending = get_ending(word_guessed)
    print("ИГРА ОКОНЧЕНА")
    print("Масть: " + str(game_state["suit"]))
    print("Монеты: " + str(alisa["монеты"]) + " | Карты: " + str(alisa["карты"]) + " | Жизни: " + str(alisa["жизни"]))
    print("Союзники (" + str(len(alisa["союзники"])) + "): " + (", ".join(alisa["союзники"]) if alisa["союзники"] else "нет"))
    print("Враги (" + str(len(alisa["враги"])) + "): " + (", ".join(alisa["враги"]) if alisa["враги"] else "нет"))
    print("Побед в битвах: " + str(game_state["battle_wins"]))
    print("Собранные буквы: " + "".join(alisa["буквы"]))
    print("Концовка: " + final_ending)
    print("ЗАЗЕРКАЛЬЕ")
    save_log("game_log.txt", final_ending)


main_game()
